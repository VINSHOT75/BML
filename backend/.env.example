# Local development defaults. Copy this file to .env and fill in private values.
DATABASE_URL=sqlite:///data/bookmyload.db
CORS_ORIGINS=http://localhost:3000
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=BookMyLoad/1.0 (contact: you@example.com)
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_ALLOWED_DOMAINS=
DEFAULT_ORGANIZATION_NAME=BookMyLoad
PLATFORM_ADMIN_EMAILS=
EMAIL_WORKER_ENABLED=false
REMINDER_SCAN_INTERVAL_SECONDS=3600
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_USE_SSL=false
